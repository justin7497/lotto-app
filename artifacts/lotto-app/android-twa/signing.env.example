# Copy to signing.env and set your keystore passwords.
# Required for: pnpm run build:android-aab (from repo root)
BUBBLEWRAP_KEYSTORE_PASSWORD=change-me
BUBBLEWRAP_KEY_PASSWORD=change-me

# Play Console → 앱 무결성 → 앱 서명 → 앱 서명 키 인증서 → SHA-256 (기존 키)
# Play Store 설치 앱에서 TWA 주소창을 숨기려면 필수입니다.
PLAY_APP_SIGNING_SHA256=

# Play Console → 앱 무결성 → 양자 내성 암호화 키 → SHA-256
# 최신 Android 기기에서 주소창이 보이면 이 값도 추가하세요.
PLAY_QUANTUM_SHA256=