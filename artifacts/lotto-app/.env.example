# Firebase (콘솔 > 프로젝트 설정 > 일반 > 내 앱 > SDK 구성)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 웹 푸시 알림 (Firebase 콘솔 > Cloud Messaging > Web Push 인증서)
VITE_FIREBASE_VAPID_KEY=

# Google Maps (Google Cloud Console > API 키, HTTP 리퍼러 제한 권장)
# 활성화: Maps JavaScript API, Geocoding API (빌드 시 좌표 캐시)
# Geocoding: 월 10,000건 무료(매월 리셋), 주소별 영구 캐시로 재호출 최소화
# Dynamic Maps: 월 10,000 로드 무료
# 예: https://lotto-app-ljh.web.app/*
VITE_GOOGLE_MAPS_API_KEY=

# 관리자 페이지 (/admin) — 콤마로 여러 이메일 가능. Functions ADMIN_EMAILS와 동일하게 설정
VITE_ADMIN_EMAILS=admin@example.com

# 빌드 스크립트 지오코딩 전용 (서버 호출, Geocoding API만 허용 권장)
GOOGLE_MAPS_GEOCODE_API_KEY=
